+export const REDACTED = '[redacted]'
+export const UNSUPPORTED_URL = '[unsupported URL]'
+
+const SAFE_METHODS = new Set([
+  'DELETE',
+  'GET',
+  'HEAD',
+  'OPTIONS',
+  'PATCH',
+  'POST',
+  'PUT',
+])
+const SAFE_MEDIA_FAMILIES = new Set([
+  'application',
+  'audio',
+  'font',
+  'image',
+  'multipart',
+  'text',
+  'video',
+])
+const SAFE_MEDIA_TYPES = new Set([
+  'application/json',
+  'application/octet-stream',
+  'application/x-www-form-urlencoded',
+  'multipart/form-data',
+  'text/css',
+  'text/event-stream',
+  'text/html',
+  'text/javascript',
+  'text/plain',
+])
+
+export function sanitizeMethod(value: any) {
+  const method = String(value == null ? '' : value).toUpperCase()
+  return SAFE_METHODS.has(method) ? method : 'OTHER'
+}
+
+function sanitizeMediaType(value: any) {
+  const text = String(value).trim()
+  const mediaType = text.split(';', 1)[0].trim().toLowerCase()
+  if (SAFE_MEDIA_TYPES.has(mediaType)) return mediaType
+
+  const separator = mediaType.indexOf('/')
+  const family = separator < 0 ? '' : mediaType.slice(0, separator)
+  if (SAFE_MEDIA_FAMILIES.has(family)) {
+    return `${family}/${REDACTED}`
+  }
+  return REDACTED
+}
+
+function sanitizeContentLength(value: any) {
+  const text = String(value)
+  return /^\d{1,15}$/.test(text)
+    ? text.replace(/^0+(?=\d)/, '')
+    : REDACTED
+}
+
+function getContentLength(value: any) {
+  const text = sanitizeContentLength(value)
+  return text === REDACTED ? 0 : toNum(text)
+}
+
+function setRedactedHeader(ret: any, name: any, value: any) {
+  const key = String(name).toLowerCase()
+  if (key === 'content-type') {
+    ret[key] = sanitizeMediaType(value)
+  } else if (key === 'content-length') {
+    ret[key] = sanitizeContentLength(value)
+  }
+}
+
+export function redactHeaders(headers: any) {
+  const ret: any = {}
+  if (!headers) return ret
+
+  const setHeader = (value: any, name: string) => {
+    setRedactedHeader(ret, name, value)
+  }
+
+  if (Array.isArray(headers)) {
+    each(headers, header => {
+      if (Array.isArray(header) && header.length > 1) {
+        setHeader(header[1], header[0])
+      }
+    })
+    return ret
+  }
+
+  if (typeof headers.forEach === 'function') {
+    headers.forEach(setHeader)
+    return ret
+  }
+
+  each(headers, setHeader)
+  return ret
+}
+
