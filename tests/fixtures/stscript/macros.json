            },
            "index": {
                "commands": [{ "name": "stp-plain", "start": 1, "end": 27 }],
                "closures": [{ "start": 1, "end": 26 }],
                "macros": [{ "name": "user", "start": 11, "end": 19 }],
                "scopes": [[]]
            }
        }
    },
