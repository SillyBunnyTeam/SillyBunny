    {
        "name": "import names reach later commands",
        "script": "/import from=Set a as b c | /stp-plain tail",
        "positions": true,
        "expected": {
            "tree": {
                "variables": ["b", "c"],
                "executors": [
                    {
                        "name": "import",
                        "named": [{ "name": "from", "value": "Set", "start": 8, "end": 16 }],
                        "unnamed": [
                            { "value": "a", "start": 17, "end": 18 },
                            { "value": "as", "start": 19, "end": 21 },
                            { "value": "b", "start": 22, "end": 23 },
                            { "value": "c", "start": 24, "end": 25 }
                        ],
                        "pos": {
                            "start": 1,
                            "end": 26,
                            "startNamedArgs": 8,
                            "endNamedArgs": 16,
                            "startUnnamedArgs": 17,
                            "endUnnamedArgs": 26
                        }
                    },
                    {
                        "name": "stp-plain",
                        "unnamed": [{ "value": "tail", "start": 39, "end": 43 }],
                        "pos": {
                            "start": 29,
