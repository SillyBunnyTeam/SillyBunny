    {
        "name": "named and unnamed arguments",
        "script": "/stp-plain key=value rest",
        "positions": true,
        "expected": {
            "tree": {
                "executors": [
                    {
                        "name": "stp-plain",
                        "named": [{ "name": "key", "value": "value", "start": 11, "end": 20 }],
                        "unnamed": [{ "value": "rest", "start": 21, "end": 25 }],
                        "pos": {
                            "start": 1,
                            "end": 25,
                            "startNamedArgs": 11,
                            "endNamedArgs": 20,
                            "startUnnamedArgs": 21,
                            "endUnnamedArgs": 25
                        }
                    }
                ]
            },
            "index": {
                "commands": [{ "name": "stp-plain", "start": 1, "end": 25 }],
                "closures": [{ "start": 1, "end": 24 }],
                "macros": [],
                "scopes": [[]]
            }
        }
    },
