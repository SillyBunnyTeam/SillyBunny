                            "end": 34,
                            "startNamedArgs": 11,
                            "endNamedArgs": 11,
                            "startUnnamedArgs": 11,
                            "endUnnamedArgs": 34
                        }
                    }
                ]
            },
            "index": {
                "commands": [
                    { "name": "stp-plain", "start": 1, "end": 34 },
                    { "name": "stp-plain", "start": 15, "end": 27 }
                ],
